
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	
	
	// ---------- 1. Проверки шапки документа ----------
	
	
	
	// дата не должна быть в будущем, прошлые даты можно
	
	Если Дата > ТекущаяДата() Тогда
		
		Сообщить("Дата документа не может быть в будущем!");
		
		Отказ = Истина;
		
	КонецЕсли;
	
	
	
	// пустой приход не записываем
	
	Если Товары.Количество() = 0 Тогда
		
		Сообщить("Добавьте хотя бы один товар!");
		
		Отказ = Истина;
		
	КонецЕсли;
	
	
	
	// без поставщика нельзя
	
	Если НЕ ЗначениеЗаполнено(Поставщик) Тогда
		
		Сообщить("Укажите поставщика!");
		
		Отказ = Истина;
		
	КонецЕсли;
	
	
	
	// и без склада тоже
	
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		
		Сообщить("Укажите склад!");
		
		Отказ = Истина;
		
	КонецЕсли;
	
	
	
	// ---------- 2. Главный цикл: проверка строк и сумма документа ----------
	
	
	
	// копилки: общая сумма и строки, где 50 шт и больше
	
	СуммаДокумента = 0;
	
	КрупныхСтрок = 0;
	
	
	
	Для Каждого Строка Из Товары Цикл
		
		
		
		// количество должно быть заполнено
		
		Если НЕ ЗначениеЗаполнено(Строка.Количество) Тогда
			
			Сообщить("В строке " + Строка.НомерСтроки + " не указано количество!");
			
			Отказ = Истина;
			
		КонецЕсли;
		
		
		
		// цена тоже
		
		Если НЕ ЗначениеЗаполнено(Строка.Цена) Тогда
			
			Сообщить("В строке " + Строка.НомерСтроки + " не указана цена!");
			
			Отказ = Истина;
			
		КонецЕсли;
		
		
		
		// сумма строки = Функция(кол * цена), и сразу кладём её в копилку документа
		
		Строка.Сумма = ПосчитатьСумму(Строка.Количество, Строка.Цена);
		
		СуммаДокумента = СуммаДокумента + Строка.Сумма;
		
		
		
		// считаем крупные строки (50 шт и больше)
		
		Если Строка.Количество >= 50 Тогда
			
			КрупныхСтрок = КрупныхСтрок + 1;
			
		КонецЕсли;
		
		
		
	КонецЦикла;
	
	
	
	ПоказатьИтоги(СуммаДокумента);
	
	Сообщить("Крупных строк: " + КрупныхСтрок);
	
	Сообщить("НДС: " + ПосчитатьНДС(СуммаДокумента));
	
	
	
	// ---------- Задания которые я взял с интернета (Дни 1–3) ----------
	
	
	
	// копилка: сколько строк с ценой меньше 100
	
	СтрокиНизЦены = 0;
	
	Для Каждого Строка Из Товары Цикл
		
		Если Строка.Цена < 100 Тогда
			
			СтрокиНизЦены = СтрокиНизЦены + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить("Строк с ценой ниже 100: " + СтрокиНизЦены);
	
	
	
	// коробка: дешёвые товары (цена < 100), потом выводим по одному
	
	ДешевыеТовары = Новый Массив;
	
	Для Каждого Строка Из Товары Цикл
		
		Если Строка.Цена < 100 Тогда
			
			ДешевыеТовары.Добавить(Строка.Товар);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ДешевыйТовар Из ДешевыеТовары Цикл
		
		Сообщить("Дешёвый товар: " + ДешевыйТовар);
		
	КонецЦикла;
	
	
	
	// коробка: номера строк, где меньше 3 шт, потом выводим каждый номер
	
	НомераМалых = Новый Массив;
	
	Для Каждого Строка Из Товары Цикл
		
		Если Строка.Количество < 3 Тогда
			
			НомераМалых.Добавить(Строка.НомерСтроки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить("Строк, где меньше 3 шт: " + НомераМалых.Количество()); 
	
	
	Для Каждого Номер Из НомераМалых Цикл
		
		Сообщить("Мало товара в строке 	" + Номер);
		
	КонецЦикла;
	
	
	
	// коробка + копилка в одном цикле: «дорогие» строки (цена больше 20)
	
	ДорогиеСтроки = Новый Массив;
	
	ДорогаяКопилка = 0;
	
	Для Каждого Строка Из Товары Цикл
		
		Если Строка.Цена > 20 Тогда
			
			// цикл стоит на ОДНОЙ дорогой строке: кладём её номер в коробку,
			
			// а её сумму прибавляем к копилке
			
			ДорогиеСтроки.Добавить(Строка.НомерСтроки);
			
			ДорогаяКопилка = ДорогаяКопилка + Строка.Сумма;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить("Строк с ценой выше 20: " + ДорогиеСтроки.Количество());
	
	Сообщить("Сумма строк с ценой выше 20: " + ДорогаяКопилка);  
	
	// ПриходТовара нужно найти дешёвые строки, где цена меньше 10, вывести общее кол-во + строки отдельно
	
	ДешевыеСтроки = Новый Массив;
	ДешеваяКопилка = 0;    
	
	Для Каждого Строка Из Товары Цикл
		Если Строка.Цена < 10 Тогда
			
			ДешевыеСтроки.Добавить(Строка.НомерСтроки);
			ДешеваяКопилка = ДешеваяКопилка + Строка.Количество; 
		КонецЕсли;
	КонецЦикла;
	Сообщить("Штук в дешёвых строках: " + ДешеваяКопилка); 
	
	
	Для Каждого Номер Из ДешевыеСтроки Цикл 
		
	Сообщить("Номер дешевой строки: №" + Номер); 
	
	КонецЦикла;
	
	
	
	
	
	
	// структура: сумма документа и сколько всего строк
	
	Итоги = Новый Структура;
	
	Итоги.Вставить("Сумма", СуммаДокумента);
	
	Итоги.Вставить("КоличествоСтрок", Товары.Количество());
	
	Сообщить("Итоги.Сумма: " + Итоги.Сумма);
	
	Сообщить("Итоги.КоличествоСтрок: " + Итоги.КоличествоСтрок);  
	
    // Задача 7: выведи товар и количество из строк всех приходов.  

	ЗапросВыводаВсехПриходов = Новый Запрос;
	ЗапросВыводаВсехПриходов.УстановитьПараметр("Ссылка", Ссылка);
	// ЗапросВыводаВсехПриходов.Выполнить().Выбрать();
	ЗапросВыводаВсехПриходов.Текст = "ВЫБРАТЬ
	                                 |	ПриходТовараТовары.Товар КАК Товар,
	                                 |	СУММА(ПриходТовараТовары.Количество) КАК Количество
	                                 |ИЗ
	                                 |	Документ.ПриходТовара.Товары КАК ПриходТовараТовары
	                                 |ГДЕ
	                                 |	ПриходТовараТовары.Ссылка = &Ссылка
	                                 |
	                                 |СГРУППИРОВАТЬ ПО
	                                 |	ПриходТовараТовары.Товар" ;
    ВыборкаВсехПриходов = ЗапросВыводаВсехПриходов.Выполнить().Выбрать();
	Пока ВыборкаВсехПриходов.Следующий() Цикл
		Сообщить(""+ ВыборкаВсехПриходов.Товар + " Количество: " + ВыборкаВсехПриходов.Количество);
		КонецЦикла;

//Задание 12. В документе «Приход товара» при записи выведи номера и даты всех расходов товара со склада документа за день документа.  
  // Номер и дата -  Расход 000000001 от 12.10.2026 19:45:00
  // Дата - День в который записан документ - Т.е дата, документа который открыт и где делаем запись 
  // Открываем документ - жмем провести - Документ в сообщениях выдает все расходы товара которые были в день документа
	

   ЗапросНомерДатаТекДень = Новый Запрос;
                                 // Установить параметр
   ЗапросНомерДатаТекДень.УстановитьПараметр("Склад", Склад);
   ЗапросНомерДатаТекДень.УстановитьПараметр("НачалоПериода", НачалоДня(Дата));
   ЗапросНомерДатаТекДень.УстановитьПараметр("КонецПериода", КонецДня(Дата));
   ЗапросНомерДатаТекДень.Текст = "ВЫБРАТЬ
                                  |	РасходТовара.Номер КАК Номер,
                                  |	РасходТовара.Дата КАК Дата               
                                  |ИЗ
                                  |	Документ.РасходТовара КАК РасходТовара
                                  |ГДЕ
                                  |	РасходТовара.Склад = &Склад
                                  |	И РасходТовара.Дата >= &НачалоПериода
                                  |	И РасходТовара.Дата <= &КонецПериода" ;
   ВыборкаНомерДатаТекДень = ЗапросНомерДатаТекДень.Выполнить().Выбрать();
   Пока ВыборкаНомерДатаТекДень.Следующий() Цикл
	   Сообщить("Расход " + ВыборкаНомерДатаТекДень.Номер + " от " + ВыборкаНомерДатаТекДень.Дата); 
	   КонецЦикла;
	
КонецПроцедуры

// ============================================================
// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
// ============================================================

// выводит итоговую сумму документа
Процедура ПоказатьИтоги(Сумма)
	
	Сообщить("Итого: " + Сумма);
КонецПроцедуры

// сумма строки: количество * цена
Функция ПосчитатьСумму(Кол, Цена)
	
	Возврат Кол * Цена;
КонецФункции

// НДС 20% от суммы
Функция ПосчитатьНДС(Сумма)
	
	Возврат Сумма * 20 / 100;
КонецФункции           

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	
	Для Каждого Строка Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Товар = Строка.Товар;
		// склад один на весь документ, он в шапке, поэтому без «Строка.»
		Движение.Склад = Склад;
		Движение.Количество = Строка.Количество;
	КонецЦикла;
	
КонецПроцедуры