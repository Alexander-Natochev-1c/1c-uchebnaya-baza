Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)   
	//Задача: сделай такой же контроль остатков в документе СписаниеТовара. Нельзя списать больше, чем есть на складе.
		Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Остатки.КоличествоОстаток КАК ОстатокНаСкладе
	|ИЗ РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки
	|ГДЕ Остатки.Склад = &Склад И Остатки.Товар = &Товар";
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Для Каждого Строка Из Товары Цикл
		Запрос.УстановитьПараметр("Товар", Строка.Товар);
		Выборка = Запрос.Выполнить().Выбрать();
		Остаток = 0;
		Если Выборка.Следующий() Тогда
			Остаток = Выборка.ОстатокНаСкладе;
		КонецЕсли;
		Если Строка.Количество > Остаток Тогда
			Сообщить("Не хватает " + Строка.Товар + ": есть " + Остаток + ", нужно " + Строка.Количество);
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	
	
	
	
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	// Движения - Слово 1С, ОстаткиТоваров-Мы создали, мы как бы говорим, запиши 
	
	Для Каждого Строка Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		//  Движение = Движение.ОстаткиТоваров.Добавить(); - Этим мы создаем движение
		// и все следующие Движение. Передадутся в остаткитоваров как расход или приход т.е Мы добавляем 
		// значения в то что далее указываем
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата; // т.к это не строка, а шапка, тут не указываем Строка
		Движение.Склад = Склад; 
		Движение.Товар = Строка.Товар;   // т.к это страка, а не шапка, тут указываем СТрока
		Движение.Количество = Строка.Количество;
	КонецЦикла;
КонецПроцедуры