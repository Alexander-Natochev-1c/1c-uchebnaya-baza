&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	СтрокаТовара = Элементы.Товары.ТекущиеДанные;
	СтрокаТовара.Сумма = СтрокаТовара.Цена * СтрокаТовара.Количество;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	СтрокаТовары = Элементы.Товары.ТекущиеДанные;
	СтрокаТовары.Сумма = СтрокаТовары.Цена * СтрокаТовары.Количество;
КонецПроцедуры

&НаКлиенте
Процедура ОбщееКоличество(Команда)
	КоличествоТоваровВБазе = ПолучитьКоличествоТоваров();
	Сообщить("Товаров в справочнике: " + КоличествоТоваровВБазе);	
	ОбщКоличество = Объект.Товары.Итог("Количество");
	Сообщить("Общее количество: " + ОбщКоличество);
КонецПроцедуры

&НаКлиенте
Процедура ИтоговаяСумма(Команда)
	ПроверитьСервер();
	ИтогСумма = Объект.Товары.Итог("Сумма");
	Сообщить("Итоговая сумма: " + ИтогСумма);
КонецПроцедуры

&НаСервере
Процедура ПроверитьСервер()
	Сообщить("Процедура выполнена на сервере");
КонецПроцедуры


&НаКлиенте
Процедура КоличествоСкладов(Команда)   
	
	
	ОбщКолВоСкладов = ПолучитьКоличествоСкладов();
	
	Если ОбщКолВоСкладов > 1 Тогда 
		Сообщить("Есть выбор складов");
	ИначеЕсли ОбщКолВоСкладов = 1 Тогда 
		Сообщить("Склад один");
	Иначе 
		Сообщить("Склады не заведены");
	КонецЕсли;
КонецПроцедуры  


&НаСервере
Функция ПолучитьКоличествоСкладов()
	ЗапросКоличествоСкладов = Новый Запрос;
	ЗапросКоличествоСкладов.Текст = "ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК КоличествоСкладов
	|ИЗ
	|	Справочник.Склады КАК Склады" ;
	Выборка = ЗапросКоличествоСкладов.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоСкладов;
	КонецЕсли;
	
	
КонецФункции



&НаСервере
Функция ПолучитьКоличествоТоваров()
	ЗапросКоличествоТоваровСправочник = Новый Запрос;
	ЗапросКоличествоТоваровСправочник.Текст = "ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК КоличествоТоваров
	|ИЗ
	|	Справочник.Товары КАК Товары";
	
	Выборка = ЗапросКоличествоТоваровСправочник.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоТоваров;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ТоварыТоварПриИзменении(Элемент)
	СтрокаТовара = Элементы.Товары.ТекущиеДанные;
	СтрокаТовара.Цена = ПолучитьЦенуТовара(СтрокаТовара.Товар, Объект.Дата); 
	Если СтрокаТовара.Цена = 0 Тогда
		Сообщить("В строке с товаром: "+ СтрокаТовара.Товар + ". Цена не заполнена!");
	КонецЕсли;
	СтрокаТовара.Сумма = СтрокаТовара.Количество * СтрокаТовара.Цена;
	
КонецПроцедуры  


&НаСервере
Функция ПолучитьЦенуТовара(ВыбранныйТовар, ДатаЦена)
	Отбор = Новый Структура("Товар", ВыбранныйТовар);
	ДанныеЦены = РегистрыСведений.ЦеныТоваров.ПолучитьПоследнее(ДатаЦена, Отбор);
	Возврат ДанныеЦены.Цена;
КонецФункции

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)	
	ОбновитьЦеныТоваров();
КонецПроцедуры

&НаСервере
Процедура ОбновитьЦеныТоваров()
	Для Каждого СтрокаТовара ИЗ Объект.Товары Цикл 
		СтрокаТовара.Цена = ПолучитьЦенуТовара(СтрокаТовара.Товар, Объект.Дата);
		СтрокаТовара.Сумма = СтрокаТовара.Количество * СтрокаТовара.Цена;		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЦены(Команда)
	Для Каждого Строка ИЗ Объект.Товары Цикл 
		КоличествоПустыхЦен = 0;
		Если Строка.Цена = 0 Тогда
			КоличествоПустыхЦен = КоличествоПустыхЦен + 1;
			Сообщить("Количество пустых цен: " + КоличествоПустыхЦен);
		КонецЕсли;
	КонецЦикла;
	Если КоличествоПустыхЦен = 0 Тогда
		Сообщить("Товаров с нулевой ценой нету!");
	КонецЕсли;
	
КонецПроцедуры


