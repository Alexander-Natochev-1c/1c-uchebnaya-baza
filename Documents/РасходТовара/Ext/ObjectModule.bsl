Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Для Каждого Строка Из Товары Цикл
		Отбор = Новый Структура("Товар", Строка.Товар);
		ДанныеЦены = РегистрыСведений.ЦеныТоваров.ПолучитьПоследнее(Дата, Отбор);
		Строка.Цена = ДанныеЦены.Цена;
		// здесь твоя строка: сумма = количество * цена   
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЦикла;
	
КонецПроцедуры


Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	
	Для Каждого Строка Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = Строка.Товар;
		// склад один на весь документ, он в шапке, поэтому без «Строка.»
		Движение.Склад = Склад;
		Движение.Количество = Строка.Количество;
	КонецЦикла;
	
КонецПроцедуры    
