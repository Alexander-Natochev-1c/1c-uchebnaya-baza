Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// 1. Цены из регистра цен (это было и раньше)
	Для Каждого Строка Из Товары Цикл
		Отбор = Новый Структура("Товар", Строка.Товар);
		ДанныеЦены = РегистрыСведений.ЦеныТоваров.ПолучитьПоследнее(Дата, Отбор);
		Строка.Цена = ДанныеЦены.Цена;
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЦикла;
	
	// 2. Контроль остатков
	// Запрос — придумали мы: записка кладовщику
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Остатки.КоличествоОстаток КАК ОстатокНаСкладе
	|ИЗ РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки
	|ГДЕ Остатки.Склад = &Склад И Остатки.Товар = &Товар";
	Запрос.УстановитьПараметр("Склад", Склад);	
	Для Каждого Строка Из Товары Цикл
		Запрос.УстановитьПараметр("Товар", Строка.Товар);
		Выборка = Запрос.Выполнить().Выбрать();
		Остаток = 0;
		Если Выборка.Следующий() Тогда
			Остаток = Выборка.ОстатокНаСкладе;
		КонецЕсли;
		Если Строка.Количество > Остаток Тогда
			Сообщить("Не хватает " + Строка.Товар + ": есть " + Остаток + ", нужно " + Строка.Количество);
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;  
	
	
	ЗапросИтого = Новый Запрос;
	ЗапросИтого.Текст = "ВЫБРАТЬ
	|	ОстаткиТоваровОстатки.Товар КАК Товар,
	|	СУММА(ОстаткиТоваровОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки КАК ОстаткиТоваровОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиТоваровОстатки.Товар
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОстаткиТоваровОстатки.Товар.Наименование" ;
	// Выводим Товар: (100) к примеру  
	Выборка = ЗапросИтого.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщить(""+Выборка.Товар + ": " + Выборка.КоличествоОстаток); 
	КонецЦикла;
	
	// Вывести все товары где товар весовой
	ЗапросВесовыхТоваров = Новый Запрос;
	ЗапросВесовыхТоваров.УстановитьПараметр("Весовой", Истина);
	
	ЗапросВесовыхТоваров.Текст = "ВЫБРАТЬ
	|	Товары.Наименование КАК Наименование,
	|	Товары.Артикул КАК Артикул
	|ИЗ
	|	Справочник.Товары КАК Товары
	|ГДЕ
	|	Товары.Весовой = &Весовой";
	ВыборкаВесовых = ЗапросВесовыхТоваров.Выполнить().Выбрать();
	
	Пока ВыборкаВесовых.Следующий() Цикл
		Сообщить(""+ ВыборкаВесовых.Наименование + ", арт. " + ВыборкаВесовых.Артикул);
	КонецЦикла;
	
	
	ЗапросВсеСклады = Новый Запрос;
	ЗапросВсеСклады.Текст = "ВЫБРАТЬ
	|	Склады.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Склады КАК Склады" ;
	ВыборкаВсехСкладов = ЗапросВсеСклады.Выполнить().Выбрать();
	Пока ВыборкаВсехСкладов.Следующий() Цикл
		Сообщить(ВыборкаВсехСкладов.Наименование);
	КонецЦикла;   
	
	
	// Задача 4: вывести номера приходов, у которых в поле Склад выбран Магазин.
	
	ЗапросСкладаМагазин = Новый Запрос;
	ЗапросСкладаМагазин.УстановитьПараметр("Склад", Склад);
	ЗапросСкладаМагазин.Текст = "ВЫБРАТЬ
	|	ПриходТовара.Номер КАК Номер,
	|	ПриходТовара.Дата КАК Дата
	|ИЗ
	|	Документ.ПриходТовара КАК ПриходТовара
	|ГДЕ
	|	ПриходТовара.Склад = &Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриходТовара.Дата" ;
	ВыборкаСкладаМагазин = ЗапросСкладаМагазин.Выполнить().Выбрать();
	Пока ВыборкаСкладаМагазин.Следующий() Цикл
		Сообщить(ВыборкаСкладаМагазин.Номер + " " + ВыборкаСкладаМагазин.Дата);
	КонецЦикла;  
	
	
	// Задача 5: показать приходы на склад из шапки, которые были раньше даты этого расхода	
	ЗапросСкладаДата = Новый Запрос; 
	ЗапросСкладаДата.УстановитьПараметр("Дата", Дата);
	ЗапросСкладаДата.УстановитьПараметр("Склад", Склад);

	
	ЗапросСкладаДата.Текст = "ВЫБРАТЬ
	                         |	ПриходТовара.Дата КАК Дата,
	                         |	ПриходТовара.Номер КАК Номер
	                         |ИЗ
	                         |	Документ.ПриходТовара КАК ПриходТовара
	                         |ГДЕ
	                         |	ПриходТовара.Дата < &Дата
	                         |	И ПриходТовара.Склад = &Склад" ;
	
	ВыборкаПриходаДатойНиже = ЗапросСкладаДата.Выполнить().Выбрать();
	Пока ВыборкаПриходаДатойНиже.Следующий() Цикл
		Сообщить("В приходе: №" + ВыборкаПриходаДатойНиже.Номер + " дата раньше чем текуший расход");
	КонецЦикла;  
	
	// Задача 9: выведи, сколько каждого товара ушло со склада из шапки за всё время.
	
	
	
	ЗапросРасходТовара = Новый Запрос; 
	ЗапросРасходТовара.УстановитьПараметр("Склад", Склад);
	ЗапросРасходТовара.УстановитьПараметр("НачалоПериода", НачалоДня(Дата));
	ЗапросРасходТовара.УстановитьПараметр("КонецПериода", КонецДня(Дата));
	
	
	
	ЗапросРасходТовара.Текст = "ВЫБРАТЬ
	                           |	ОстаткиТоваровОбороты.Товар КАК Товар,
	                           |	СУММА(ОстаткиТоваровОбороты.КоличествоРасход) КАК КоличествоРасход,
							   |    СУММА(ОстаткиТоваровОбороты.КоличествоПриход) КАК КоличествоПриход
	                           |ИЗ
	                           |	РегистрНакопления.ОстаткиТоваров.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ОстаткиТоваровОбороты
	                           |ГДЕ
	                           |	ОстаткиТоваровОбороты.Склад = &Склад
	                           |
	                           |СГРУППИРОВАТЬ ПО
	                           |	ОстаткиТоваровОбороты.Товар" ;
	
	ВыборкаРасходТовара = ЗапросРасходТовара.Выполнить().Выбрать();
	
	Пока ВыборкаРасходТовара.Следующий() Цикл
		Сообщить("" + ВыборкаРасходТовара.Товар +" пришло "+ ВыборкаРасходТовара.КоличествоПриход + ", ушло со склада " + ВыборкаРасходТовара.КоличествоРасход);
	КонецЦикла;                                          	
	
		

	
	
	
	
	
	
	
		
	
	
	
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	
	Для Каждого Строка Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = Строка.Товар;
		// склад один на весь документ, он в шапке, поэтому без «Строка.»
		Движение.Склад = Склад;
		Движение.Количество = Строка.Количество;
	КонецЦикла;
	
КонецПроцедуры    
